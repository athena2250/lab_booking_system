# Copy to .env and fill in. .env is gitignored (.env* rule) — keep it that way.
# Setup instructions for every value below: plan/08-external-services.md

# Database — PostgreSQL connection string (Step 2)
DATABASE_URL=

# Shared staff-room login (Step 3)
# SESSION_SECRET: openssl rand -base64 32
TEACHER_USERNAME=
TEACHER_PASSWORD=
SESSION_SECRET=

# Email — Gmail SMTP (Step 7/8)
# GMAIL_APP_PASSWORD is a 16-character App Password (requires 2FA), not the
# account password. Use a dedicated school account, not a personal one.
# RECIPIENT_EMAILS: comma-separated, no spaces.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAILS=

# WhatsApp — Twilio (Step 7/8)
# Both numbers keep the literal "whatsapp:" prefix and E.164 format,
# e.g. whatsapp:+14155238886 / whatsapp:+91XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
