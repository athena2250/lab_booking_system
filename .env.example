# Copy to .env and fill in. .env is gitignored (.env* rule) — keep it that way.
# Setup instructions for every value below: plan/08-external-services.md

# Database — PostgreSQL connection strings (Step 2, Step 9)
# DATABASE_URL is the pooled connection the app uses at runtime; on Neon that
# is the host with "-pooler" in it. DIRECT_DATABASE_URL is the unpooled one,
# used only by `prisma migrate deploy`. Locally there is no pooler — set both
# to the same local URL. Both are required: the schema declares them.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Sessions (Step 3)
# SESSION_SECRET signs the session cookie, which now carries the signed-in
# teacher's id, name and role: openssl rand -base64 32
# Changing it signs everybody out, which is also how you revoke every session.
SESSION_SECRET=

# Bootstrap account (Step 3)
# Teachers sign themselves up at /signup with their @ncfe.ac.in address and
# choose their own password. These three only seed the FIRST account — the
# admin who has to exist before anyone can be promoted:
#
#   npm run teachers:bootstrap      # creates/refreshes the admin below
#   npm run teachers -- list
#   npm run teachers -- add "Asha Rao" asha@ncfe.ac.in
#
# TEACHER_EMAIL must be an @ncfe.ac.in address — the same rule the sign-up form
# applies. The bootstrap account is an ADMIN. TEACHER_NAME is the display name
# bookings are made under and defaults to "Staff Room". `scripts/verify.mjs`
# signs in with this pair, which is why it stays in the environment.
TEACHER_EMAIL=
TEACHER_PASSWORD=
TEACHER_NAME=

# Email — Gmail SMTP (Step 7/8)
# GMAIL_APP_PASSWORD is a 16-character App Password (requires 2FA), not the
# account password. Use a dedicated school account, not a personal one.
# RECIPIENT_EMAILS: comma-separated, no spaces.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAILS=

# WhatsApp — Twilio (Step 7/8)
# Both numbers keep the literal "whatsapp:" prefix and E.164 format,
# e.g. whatsapp:+14155238886 / whatsapp:+91XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
